# Backend Java .properties syntax: copy these settings to .env.cloudinary.local.
# This file is imported only by the local profile. Hosted production uses runtime env vars.
# Find the credentials in Cloudinary Console > Settings > API Keys.
STAY_MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep this stable after uploading/migrating images. Use a different prefix for another project.
STAY_CLOUDINARY_PREFIX=stay
