# Local backend template. Copy to .env.local and fill in your own database settings.
# This is Java .properties syntax. Real credentials never belong in this example.
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_MYSQL_HOST:YOUR_MYSQL_PORT/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stable backend-only random key (32+ characters); blank uses a development key per boot.
STAY_REMEMBER_ME_KEY=

# Enable sandbox payments only after filling the separate payment settings.
STAY_PAYMENTS_ENABLED=false
STAY_ADMIN_BOOTSTRAP_ENABLED=false
