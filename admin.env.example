# Backend .env.local only. Keep disabled until you have set a separate admin email
# and your own password; never paste the password into chat or put it in React.
STAY_ADMIN_BOOTSTRAP_ENABLED=false
STAY_ADMIN_EMAIL=
STAY_ADMIN_NAME=Platform Admin
STAY_ADMIN_PASSWORD=
# Set ENABLED=true once, then restart Spring Boot. Password: 12+ characters,
# at most 72 UTF-8 bytes. After success, set ENABLED=false and remove PASSWORD.
# Existing USER/HOST accounts are never promoted; existing admin passwords are
# never overwritten. Use Forgot password to reset an existing admin password.
